<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../ExplorerExtension/out/ExplorerBridge.dll" Link="ExplorerBridge.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ExplorerExtension/out/file.exe" Link="file.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ExplorerExtension/out/file32.exe" Link="file32.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ExplorerExtension/out/ObserverSetup32.exe" Link="ObserverSetup32.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ExplorerExtension/out/ApiObserver32.dll" Link="ApiObserver32.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ExplorerExtension/out/ApiObserver64.dll" Link="ApiObserver64.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../third_party/Detours/LICENSE.md" Link="Detours-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
